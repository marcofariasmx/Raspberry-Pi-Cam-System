# Pi Camera WebCodecs Streaming Configuration
# Copy this file to .env and customize as needed

# Server Configuration
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8000

# Video Stream Settings (WebCodecs Optimized)
# Default: 1200x900 @ 20fps for good Pi Zero 2W performance
VIDEO_WIDTH=1200
VIDEO_HEIGHT=900
VIDEO_FRAMERATE=20

# H.264 Bitrate Settings
# Examples:
#   1000000  = 1 Mbps (low quality, minimal bandwidth)
#   2000000  = 2 Mbps (good quality, default)
#   3000000  = 3 Mbps (high quality)
#   5000000  = 5 Mbps (excellent quality, more bandwidth)
VIDEO_BITRATE=2000000

# WebSocket Settings
WEBSOCKET_BUFFER_SIZE=5
MAX_CONCURRENT_VIEWERS=10

# Camera Hardware Settings
CAMERA_HFLIP=false
CAMERA_VFLIP=false

# Advanced H.264 Settings (Optional)
H264_PROFILE=high
H264_QUALITY=high
GOP_SIZE=30
ENCODER_PRESET=fast

# Motion Detection (Optional - Future Feature)
MOTION_DETECTION_ENABLED=false
MOTION_THRESHOLD=7
MOTION_LORES_WIDTH=320
MOTION_LORES_HEIGHT=240

# Logging
LOG_LEVEL=INFO

# Legacy MediaMTX Settings (for reference - no longer used)
# These were used in the previous MediaMTX+WebRTC implementation
# MEDIAMTX_UDP_PORT=8891
# MEDIAMTX_WEBRTC_PORT=8443
# MEDIAMTX_HLS_PORT=8888