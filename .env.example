# Camera Streaming Configuration
# Copy this file to .env and modify as needed

# Server Configuration
CAMERA_HOST=0.0.0.0
CAMERA_PORT=8000

# Stream Configuration
# Common resolutions (uncomment and modify as needed):
# 640x480 (VGA) - Low bandwidth, good for basic monitoring
# STREAM_WIDTH=640
# STREAM_HEIGHT=480
# 800x600 (SVGA) - Balanced quality and performance (default)
STREAM_WIDTH=800
STREAM_HEIGHT=600
# 1024x768 (XGA) - Higher quality, more bandwidth
# STREAM_WIDTH=1024
# STREAM_HEIGHT=768
# 1280x720 (HD 720p) - HD quality
# STREAM_WIDTH=1280
# STREAM_HEIGHT=720
# 1920x1080 (Full HD 1080p) - Highest quality, requires good network
# STREAM_WIDTH=1920
# STREAM_HEIGHT=1080
STREAM_FPS=15
JPEG_QUALITY=85

# MJPEG Encoder Settings (when hardware MJPEG is available)
# Bitrate in bits per second - default 10 Mbps for high quality
# Examples:
#   5000000  = 5 Mbps (good for web streaming)
#   8000000  = 8 Mbps (high quality security cameras)
#   10000000 = 10 Mbps (default - excellent quality)
#   15000000 = 15 Mbps (professional quality)
#   25000000 = 25 Mbps (broadcast quality)
MJPEG_BITRATE=10000000

# Camera Hardware Settings
CAMERA_HFLIP=false
CAMERA_VFLIP=false